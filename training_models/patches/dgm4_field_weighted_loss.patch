+    def _get_dgm4_field_weight(self, text_before_token: str) -> float:
+        r"""Return field-aware loss weight for the next generated label token."""
+        line = text_before_token.split("\n")[-1]
+        finetuning_args = self.finetuning_args
+
+        if ":" not in line:
+            return finetuning_args.dgm4_format_weight
+
+        field, value_prefix = line.split(":", 1)
+        field = field.strip()
+        if not value_prefix:
+            return finetuning_args.dgm4_format_weight
+
+        if field == "Verdict":
+            return finetuning_args.dgm4_verdict_weight
+        if field in {"FS", "FA", "TS", "TA"}:
+            return finetuning_args.dgm4_atomic_weight
+        if field == "Category":
+            return finetuning_args.dgm4_category_weight
+        if field == "Fake Image Box":
+            return finetuning_args.dgm4_box_weight
+        if field == "Fake Text Pos":
+            return finetuning_args.dgm4_text_pos_weight
+
+        return 1.0
+
+    def _build_dgm4_token_weights(self, labels: "torch.Tensor") -> "torch.Tensor":
+        r"""Build token weights aligned with labels for DGM4 field-aware SFT.
+
+        The original SFT CE is kept as the default path. This helper is only used
+        when `use_dgm4_field_weighted_loss` is enabled in the training config.
+        """
+        weights = torch.ones_like(labels, dtype=torch.float32)
+        tokenizer = getattr(self.processing_class, "tokenizer", self.processing_class)
+
+        for row_idx, row in enumerate(labels.detach().cpu().tolist()):
+            generated_text = ""
+            for col_idx, token_id in enumerate(row):
+                if token_id == IGNORE_INDEX:
+                    continue
+
+                weights[row_idx, col_idx] = self._get_dgm4_field_weight(generated_text)
+                generated_text += tokenizer.decode([token_id], skip_special_tokens=False)
+
+        weights = weights.to(labels.device)
+        weights = weights.masked_fill(labels.eq(IGNORE_INDEX), 0.0)
+        return weights
+
+    def _compute_dgm4_field_weighted_loss(self, model, inputs, return_outputs: bool = False):
+        labels = inputs["labels"]
+        outputs = model(**inputs)
+        logits = outputs.logits
+
+        shift_logits = logits[..., :-1, :].contiguous()
+        shift_labels = labels[..., 1:].contiguous()
+        shift_weights = self._build_dgm4_token_weights(labels)[..., 1:].contiguous()
+
+        loss_per_token = F.cross_entropy(
+            shift_logits.view(-1, shift_logits.size(-1)).float(),
+            shift_labels.view(-1),
+            ignore_index=IGNORE_INDEX,
+            reduction="none",
+        ).view_as(shift_labels)
+
+        valid_weight_sum = shift_weights.sum().clamp_min(1.0)
+        loss = (loss_per_token * shift_weights).sum() / valid_weight_sum
+        return (loss, outputs) if return_outputs else loss
+
